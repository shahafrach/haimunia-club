# Cloudflare Pages response headers for https://haimunia.pages.dev (the repo root is the site).
#
# WHY A HEADER AS WELL AS THE <meta> CSP IN index.html: `frame-ancestors` is ignored in a <meta> tag, so
# clickjacking protection has to arrive as a real header, and a header CSP also covers every response
# (404.html, privacy.html), not only index.html. The two policies must say the same thing apart from
# frame-ancestors; test/headers.test.mjs fails if they drift.
#
# The only origins named: this app itself, the Supabase project (usage count, sign-in, club, transfer)
# and Cloudflare Turnstile (the sign-up challenge: script and frame). Nothing is inline except styles.
#
# _headers does not apply to a Pages Functions response, so functions/_middleware.js gives its own 404 the same protections. Verify with: curl -sI https://haimunia.pages.dev/
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self' https://hvwakffluwvegedefoth.supabase.co; frame-src https://challenges.cloudflare.com; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), usb=(), payment=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

# The page and the service worker are always revalidated, so a release (the new sw.js) reaches members at
# once instead of waiting out a cached copy.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
